<!-- Tokens de cor do tema claro (mesmas chaves do Escuro.xaml). Cores de estado mais escuras
     que as do tema escuro, para o texto colorido manter contraste AA sobre o branco. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Superfícies -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="SideBrush" Color="#EAEAEF"/>
    <SolidColorBrush x:Key="BgBrush" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F5F5F8"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F0F3"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D9D9DE"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2C2C8"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#59000000"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#0F000000"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="#A1A1A6"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Destaque (padrão: roxo da Upgrade Store) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F7C3AED"/>

    <!-- Estado (suaves) -->
    <SolidColorBrush x:Key="GreenBrush" Color="#1E8E3E"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#B45F06"/>
    <SolidColorBrush x:Key="RedBrush" Color="#D70015"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#0060DF"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#1F34C759"/>
    <SolidColorBrush x:Key="YellowSoftBrush" Color="#1FFF9500"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#1FFF3B30"/>
    <SolidColorBrush x:Key="BlueSoftBrush" Color="#1F007AFF"/>

    <!-- Ícones da barra lateral (squircles) -->
    <SolidColorBrush x:Key="IconBlue" Color="#007AFF"/>
    <SolidColorBrush x:Key="IconGreen" Color="#34C759"/>
    <SolidColorBrush x:Key="IconOrange" Color="#FF9500"/>
    <SolidColorBrush x:Key="IconRed" Color="#FF3B30"/>
    <SolidColorBrush x:Key="IconPurple" Color="#AF52DE"/>
    <SolidColorBrush x:Key="IconPink" Color="#FF2D55"/>
    <SolidColorBrush x:Key="IconTeal" Color="#30B0C7"/>
    <SolidColorBrush x:Key="IconIndigo" Color="#5856D6"/>
    <SolidColorBrush x:Key="IconGray" Color="#8E8E93"/>
    <SolidColorBrush x:Key="IconYellow" Color="#FFCC00"/>

    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.12</sys:Double>
</ResourceDictionary>
