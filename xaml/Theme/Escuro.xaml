<!-- Tokens de cor do tema escuro. Toda a interface usa estas chaves com DynamicResource, então
     trocar este dicionário pelo do tema claro muda tudo na hora. As cores de destaque
     (Accent*) são reescritas pelo código com a cor escolhida pelo usuário. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Superfícies -->
    <SolidColorBrush x:Key="WindowBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="SideBrush" Color="#232325"/>
    <SolidColorBrush x:Key="BgBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#353538"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#48484A"/>
    <SolidColorBrush x:Key="InputBrush" Color="#1F1F21"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#38383A"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5A5A5F"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#14FFFFFF"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#98989F"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Destaque (padrão: roxo da Upgrade Store) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#337C3AED"/>

    <!-- Estado (suaves) -->
    <SolidColorBrush x:Key="GreenBrush" Color="#32D74B"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF453A"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#2632D74B"/>
    <SolidColorBrush x:Key="YellowSoftBrush" Color="#26FF9F0A"/>
    <SolidColorBrush x:Key="RedSoftBrush" Color="#26FF453A"/>
    <SolidColorBrush x:Key="BlueSoftBrush" Color="#260A84FF"/>

    <!-- Ícones da barra lateral (squircles) -->
    <SolidColorBrush x:Key="IconBlue" Color="#0A84FF"/>
    <SolidColorBrush x:Key="IconGreen" Color="#30D158"/>
    <SolidColorBrush x:Key="IconOrange" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="IconRed" Color="#FF453A"/>
    <SolidColorBrush x:Key="IconPurple" Color="#BF5AF2"/>
    <SolidColorBrush x:Key="IconPink" Color="#FF375F"/>
    <SolidColorBrush x:Key="IconTeal" Color="#40C8E0"/>
    <SolidColorBrush x:Key="IconIndigo" Color="#5E5CE6"/>
    <SolidColorBrush x:Key="IconGray" Color="#8E8E93"/>
    <SolidColorBrush x:Key="IconYellow" Color="#FFD60A"/>

    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.45</sys:Double>
</ResourceDictionary>
