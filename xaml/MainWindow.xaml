<!-- Janela principal. Cores e estilos vêm do design system (xaml\Theme), carregado pelo código
     antes de mostrar a janela; por isso aqui só existe DynamicResource. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upgrade Tweaks"
        Width="1280" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource TextFont}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#7C3AED" Geometry="M20,0 H60 A20,20 0 0 1 80,20 V60 A20,20 0 0 1 60,80 H20 A20,20 0 0 1 0,60 V20 A20,20 0 0 1 20,0 Z"/>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M47,10 L24,46 H40 L33,70 L58,32 H42 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,12,16,10" Height="34">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE945;" FontFamily="{DynamicResource IconFont}" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Upgrade Tweaks" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{DynamicResource SearchBox}" Margin="18,2,18,10" Tag="Buscar (Ctrl+K)"
                         WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Grid DockPanel.Dock="Bottom" Margin="18,6,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VersionText" Grid.Column="0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="v0.0.0" VerticalAlignment="Center"/>
                    <Button x:Name="ThemeButton" Grid.Column="1" Style="{DynamicResource IconButton}" ToolTip="Tema: sistema / claro / escuro">
                        <TextBlock x:Name="ThemeIcon" Text="&#xE793;" FontFamily="{DynamicResource IconFont}" FontSize="14"/>
                    </Button>
                </Grid>
                <ListBox x:Name="NavList" ItemContainerStyle="{DynamicResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Once"/>
            </DockPanel>
        </Border>

        <!-- Área principal -->
        <Grid Grid.Column="1" x:Name="MainArea" Background="{DynamicResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra de título integrada: título da página e os botões do Windows à direita -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="TitleText" Text="Upgrade Tweaks" FontWeight="SemiBold" FontSize="13" Margin="32,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="MinButton" Style="{DynamicResource CaptionButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar"/>
                    <Button x:Name="MaxButton" Style="{DynamicResource CaptionButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar"/>
                    <Button x:Name="CloseButton" Style="{DynamicResource CaptionCloseButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Fechar"/>
                </StackPanel>
            </Grid>

            <!-- Aviso (modo simulação) -->
            <Border x:Name="Banner" Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="16,8" Margin="32,0,32,8" Visibility="Collapsed">
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
            </Border>

            <!-- Página -->
            <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,8,32,16"
                          Focusable="False">
                <ContentControl x:Name="PageHost" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </ScrollViewer>

            <!-- Barra de ação: seleção, preset e as ações (uma primária) -->
            <Border x:Name="ActionBar" Grid.Row="3" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,8" Margin="32,0,32,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.18"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionText" Text="Nenhuma alteração pendente" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="2,0,16,0"/>
                        <ComboBox x:Name="PresetBox" Width="170" ToolTip="Marca os ajustes de um preset"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button x:Name="SimulateButton" Content="Simular" ToolTip="Mostra o que mudaria, sem alterar nada"/>
                        <Button x:Name="UndoButton" Content="Descartar" ToolTip="Volta os switches para o estado atual, sem aplicar nada"/>
                        <Button x:Name="ApplyButton" Content="Revisar e aplicar" Style="{DynamicResource PrimaryButton}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rodapé: status, progresso e o log (recolhido) -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="32,6,32,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="Pronto." TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="BusyBar" Grid.Column="1" IsIndeterminate="False" Visibility="Hidden" Margin="12,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="LogToggle" Style="{DynamicResource LinkButton}" Content="▸ Log" Margin="0,0,16,0"/>
                            <Button x:Name="LogOpenFolder" Style="{DynamicResource LinkButton}" Content="Abrir pasta de logs" Margin="0,0,16,0"/>
                            <Button x:Name="LogCopy" Style="{DynamicResource LinkButton}" Content="Copiar log"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="LogList" Height="110" Margin="28,6,28,0" Visibility="Collapsed"
                             FontFamily="{DynamicResource MonoFont}" FontSize="12"
                             VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Sheet modal (confirmações, detalhes) sobre a janela inteira -->
        <Grid x:Name="SheetHost" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" Panel.ZIndex="50">
            <Border x:Name="SheetPanel" Background="{DynamicResource ElevatedBrush}" CornerRadius="14" MaxWidth="600" MinWidth="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Padding="28,24"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SheetShift"/>
                </Border.RenderTransform>
                <ContentControl x:Name="SheetContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
