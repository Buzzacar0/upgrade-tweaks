    {
      "id": "UT_Test_Script",
      "nome": "Teste de script",
      "descricao": "Usa script para aplicar, detectar e desfazer, guardando o original como item genérico.",
      "ganhoEsperado": "Nenhum (teste)",
      "categoria": "Latencia",
      "risco": "médio",
      "requerReinicio": true,
      "controverso": true,
      "compatibilidade": {},
      "scriptAplicar": [
        "$atual = Get-UTRegistryValue -Path 'HKCU:\\Software\\UpgradeTweaksTest\\Script' -Name 'Modo'",
        "[void](Save-UTOriginalItem -Chave 'teste|modo' -Dados ([ordered]@{ existia = $atual.ValorExiste; valor = $atual.Valor }) -TweakId $TweakId)",
        "Set-UTRegistryValue -Path 'HKCU:\\Software\\UpgradeTweaksTest\\Script' -Name 'Modo' -Type String -Value 'rapido'"
      ],
      "scriptDesfazer": [
        "$d = Pop-UTOriginalItem -Chave 'teste|modo' -TweakId $TweakId",
        "if ($d -is [System.Collections.IDictionary]) {",
        "  if ($d.existia) { Set-UTRegistryValue -Path 'HKCU:\\Software\\UpgradeTweaksTest\\Script' -Name 'Modo' -Type String -Value $d.valor }",
        "  else { [void](Remove-UTRegistryValue -Path 'HKCU:\\Software\\UpgradeTweaksTest\\Script' -Name 'Modo') }",
        "}"
      ],
      "scriptDetectar": [
        "(Get-UTRegistryValue -Path 'HKCU:\\Software\\UpgradeTweaksTest\\Script' -Name 'Modo').Valor -eq 'rapido'"
      ],
      "deteccao": "script"
    },
