    {
      "id": "UT_Custom_GodMode",
      "nome": "Atalho \"Modo Deus\" na área de trabalho",
      "descricao": "Cria na área de trabalho a pasta especial do Windows com todas as configurações do Painel de Controle numa lista só (mais de 200 itens).",
      "ganhoEsperado": "Nenhum (praticidade)",
      "categoria": "Personalizar",
      "risco": "baixo",
      "requerReinicio": false,
      "controverso": false,
      "compatibilidade": { "windows": [ "10", "11" ] },
      "scriptAplicar": [
        "$p = Join-Path $env:PUBLIC 'Desktop\\Modo Deus.{ED7BA470-8E54-465E-825C-99712043E01C}'",
        "if (-not (Test-Path -LiteralPath $p)) { New-Item -ItemType Directory -Path $p -Force | Out-Null }"
      ],
      "scriptDesfazer": [
        "$p = Join-Path $env:PUBLIC 'Desktop\\Modo Deus.{ED7BA470-8E54-465E-825C-99712043E01C}'",
        "if (Test-Path -LiteralPath $p) { [IO.Directory]::Delete($p, $false) }"
      ],
      "scriptDetectar": [ "Test-Path -LiteralPath (Join-Path $env:PUBLIC 'Desktop\\Modo Deus.{ED7BA470-8E54-465E-825C-99712043E01C}')" ],
      "scriptSimular": [ "'Cria a pasta \"Modo Deus\" na área de trabalho pública'" ],
      "deteccao": "script"
    },
