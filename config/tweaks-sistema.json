      "id": "UT_Sys_SvcHostGroup",
      "nome": "Agrupar serviços em menos processos (svchost)",
      "descricao": "Desde o Windows 10 cada serviço roda no seu próprio svchost.exe quando o PC tem mais de 3,5 GB de RAM. Este ajuste volta a agrupar os serviços, como no Windows 7: o Gerenciador de Tarefas mostra dezenas de processos a menos e sobra um pouco de RAM (100 a 300 MB). Não aumenta o FPS. Em troca, se um serviço do grupo travar, leva os outros junto.",
      "ganhoEsperado": "Pequeno (RAM); nenhum em FPS",
      "categoria": "ServicosApps",
      "risco": "médio",
      "requerReinicio": true,
      "controverso": true,
      "observacao": "Vale para PCs com até 64 GB de RAM.",
      "compatibilidade": { "windows": [ "10", "11" ] },
      "registro": [
        { "caminho": "HKLM:\\SYSTEM\\CurrentControlSet\\Control", "nome": "SvcHostSplitThresholdInKB", "tipo": "DWord", "valor": 67108864, "valorOriginal": 3670016 }
      ],
      "deteccao": "registro"
    },
    {
